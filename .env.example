# ===================================================
# VITRYNE - AMBIENTE DE PRODUÇÃO E DESENVOLVIMENTO
# Arquitetura Serverless Custo Zero (Free Tier)
# ===================================================

# 1. SEGURANÇA E CRIPTOGRAFIA (AES-256-GCM + Blind Index)
# Gere uma chave de 32 bytes em hex ou base64 (ex: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BLIND_INDEX_SECRET=vitryne_blind_index_super_secret_key_2026

# 2. PERSISTÊNCIA & RLS (Supabase Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. FILAS E RATE-LIMITING (Upstash QStash Free Tier - 500 msgs/dia)
QSTASH_URL=https://qstash.upstash.io/v2
QSTASH_TOKEN=your-upstash-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key

# 4. MEMÓRIA & TRAVAS ATÔMICAS LUA (Upstash Redis Free Tier - 10k ops/dia)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# 5. META / INSTAGRAM GRAPH API (Custo R$ 0,00 por Direct)
INSTAGRAM_APP_ID=your-meta-app-id
INSTAGRAM_APP_SECRET=your-meta-app-secret
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=vitryne_meta_webhook_verify_token_secure
# Whitelist ASN Meta: AS32934 (Cloudflare header CF-Connecting-ASN)

# 6. GATEWAY & SPLIT DE PAGAMENTOS (Asaas - Sem Mensalidade)
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=your-asaas-access-token
ASAAS_WEBHOOK_SECRET=your-asaas-webhook-secret
VITRYNE_TAKE_RATE_PERCENTAGE=2.5

# 7. LOGÍSTICA (Melhor Envio)
MELHOR_ENVIO_API_URL=https://sandbox.melhorenvio.com.br/api/v2
MELHOR_ENVIO_TOKEN=your-melhor-envio-token

# 8. APP URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
OPENAI_API_KEY=credential Open AI
